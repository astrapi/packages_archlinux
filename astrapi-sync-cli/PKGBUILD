# astrapi-sync-cli -- CLI-Client + geteilte Sync-Engine fuer astrapi-sync.
# Baut vom main-HEAD des Monorepos astrapi-sync-linux (kein PyPI-Release,
# daher weiterhin ein VCS-Paket mit git-basierter pkgver() statt fester
# Versionsnummer), aus dem Unterordner astrapi-sync-cli. Ab jetzt CalVer-
# Tags vYY.M.N wie die uebrigen astrapi-Projekte (astrapi-tools/release.sh) --
# pkgver() liest den letzten Tag per `git describe`, kein fest verdrahtetes
# "r<Commit-Anzahl>.<Hash>" mehr wie zuvor.

pkgname=astrapi-sync-cli
pkgver=26.8.1.r0.0000000
pkgrel=1
pkgdesc="CLI-Client + geteilte Sync-Engine fuer astrapi-sync (Ordner-Synchronisation ueber mehrere eigene Geraete)"
arch=('any')
url="https://github.com/astrapi/astrapi-sync-linux"
license=('GPL-3.0-or-later')
depends=('python' 'python-httpx' 'python-websockets' 'python-watchdog')
makedepends=('git' 'python-build' 'python-installer' 'python-wheel' 'python-setuptools')
source=("$pkgname::git+https://github.com/astrapi/astrapi-sync-linux.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$pkgname"
  # vYY.M.N-<Commits-seit-Tag>-g<Hash> -> YY.M.N.r<Commits-seit-Tag>.<Hash>
  # (pacman erlaubt kein '-' in pkgver, "r0" markiert einen exakten Tag-Stand).
  git describe --tags --long | sed -E 's/^v//; s/-([0-9]+)-g([0-9a-f]+)$/.r\1.\2/'
}

build() {
  cd "$srcdir/$pkgname/astrapi-sync-cli"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/$pkgname/astrapi-sync-cli"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/systemd/astrapi-sync-cli.service \
    "$pkgdir/usr/lib/systemd/user/astrapi-sync-cli.service"
}
