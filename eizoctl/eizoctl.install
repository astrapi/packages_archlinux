post_install() {
  udevadm control --reload-rules 2>/dev/null || true
  echo "Hinweis: Monitor kurz vom USB trennen/neu verbinden, damit die"
  echo "neue udev-Regel fuer den Geraeteknoten wirksam wird."
}

post_upgrade() {
  post_install
}

post_remove() {
  udevadm control --reload-rules 2>/dev/null || true
}
